#include <WiFi.h>
#include "esp_wifi.h"

// -----------------------------
// Wi-Fi Credentials
// -----------------------------
const char* SSID     = "Ripple_Airtel_Deco";
const char* PASSWORD = "Ripple@123";

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("================================");
    Serial.println(" ESP32 Wi-Fi Security Test");
    Serial.println("================================");

    // --------------------------------
    // 1. Set ESP32 as Wi-Fi Station
    // --------------------------------
    WiFi.mode(WIFI_STA);

    // --------------------------------
    // 2. Allow WPA2 or stronger 
    //    WPA3 is also accepted
    // --------------------------------
    WiFi.setMinSecurity(WIFI_AUTH_WPA2_WPA3_PSK);

    // --------------------------------
    // 3. Enable 802.11 b/g/n
    // --------------------------------
    esp_err_t result = esp_wifi_set_protocol(
        WIFI_IF_STA,
        WIFI_PROTOCOL_11B |
        WIFI_PROTOCOL_11G |
        WIFI_PROTOCOL_11N
    );

    if (result == ESP_OK)
    {
        Serial.println("802.11 b/g/n enabled");
    }
    else
    {
        Serial.println("Failed to set 802.11 b/g/n");
    }

    // --------------------------------
    // 4. Connect to Wi-Fi
    // --------------------------------
    Serial.print("Connecting to: ");
    Serial.println(SSID);

    WiFi.begin(SSID, PASSWORD);

    int count = 0;

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");

        count++;

        if (count >= 40)
        {
            Serial.println();
            Serial.println("Wi-Fi connection failed!");
            return;
        }
    }

    // --------------------------------
    // 5. Connection successful
    // --------------------------------
    Serial.println();
    Serial.println("Wi-Fi Connected!");

    Serial.print("SSID: ");
    Serial.println(WiFi.SSID());

    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());

    Serial.print("MAC Address: ");
    Serial.println(WiFi.macAddress());

    Serial.print("RSSI: ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");

    Serial.println();
    Serial.println("Security requirement: WPA2 or higher");
    Serial.println("Protocol: 802.11 b/g/n");
}

void loop()
{
    // Check Wi-Fi connection continuously

    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.println("Wi-Fi is connected");
    }
    else
    {
        Serial.println("Wi-Fi disconnected");
    }

    delay(5000);
}
